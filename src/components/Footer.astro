---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<footer class={`py-28 md:py-16 px-5 md:px-12 ${className}`}>
  <div class="max-w-[1440px] mx-auto">
    <div class="max-w-4xl">
      <p class="text-xs font-semibold text-accent uppercase tracking-wider mb-4">
        Have a project in mind?
      </p>
      <h2 class="text-hero tracking-tight mb-8 split-heading text-ink">
        Ready to get your system in shape?
      </h2>
      <p class="text-lg md:text-2xl text-muted font-normal max-w-2xl mb-12 leading-relaxed">
        Treat it like an engineering jam session. We'll map out your
        architecture, explore ideas, and build something genuinely useful.
      </p>

      <div class="flex flex-wrap items-center gap-4">
        <a
          href="mailto:me@framadhita.com"
          class="px-8 py-4 rounded-full bg-ink text-paper font-bold text-sm hover:bg-accent transition-colors duration-300"
        >
          [ me@framadhita.com ]
        </a>
        <a
          href="https://github.com/framadhita"
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 py-4 rounded-full border border-ink/20 font-bold text-sm hover:border-ink transition-colors duration-300 text-ink"
        >
          [ GitHub Profile ↗ ]
        </a>
      </div>
    </div>

    <div class="mt-28 pt-8 border-t border-line flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-muted font-medium">
      <div class="flex items-center gap-3">
        <span class="font-extrabold text-ink">FRAMADHIT4°</span>
        <span>—</span>
        <span>Based in Bandung, ID</span>
      </div>
    </div>
  </div>
</footer>
