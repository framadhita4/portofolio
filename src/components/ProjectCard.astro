---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;

// Predefined layout patterns for a more "random" editorial look
const layouts = [
  { span: "md:col-span-9", start: "md:col-start-1", mt: "md:mt-0" },      // 0
  { span: "md:col-span-6", start: "md:col-start-7", mt: "md:mt-32" },     // 1
  { span: "md:col-span-4", start: "md:col-start-2", mt: "md:mt-16" },     // 2
  { span: "md:col-span-7", start: "md:col-start-5", mt: "md:mt-48" },     // 3
  { span: "md:col-span-5", start: "md:col-start-1", mt: "md:mt-24" },     // 4
  { span: "md:col-span-8", start: "md:col-start-4", mt: "md:mt-12" },     // 5
  { span: "md:col-span-6", start: "md:col-start-2", mt: "md:mt-40" },     // 6
  { span: "md:col-span-5", start: "md:col-start-8", mt: "md:mt-16" },     // 7
];

const layout = layouts[index % layouts.length];
const colSpan = `col-span-1 ${layout.span}`;
const alignment = `${layout.start} ${layout.mt}`;
---

<a href={`/project/${project.slug}`}
  data-project-category={project.category}
  class={`project-card group relative flex flex-col opacity-0 translate-y-20 ${colSpan} ${alignment}`}
>
  <div class="project-frame relative mb-7 cursor-pointer overflow-hidden rounded-[1.75rem] border-2 border-[#161616] p-2 shadow-[7px_7px_0_#161616] transition-all duration-300 group-hover:translate-x-[3px] group-hover:translate-y-[3px] group-hover:shadow-[4px_4px_0_#161616]">
    <div class="aspect-4/3 flex w-full items-center justify-center overflow-hidden rounded-[1.25rem] border-2 border-[#161616] bg-[#fffaf1]">
      {project.image ? (
        <img 
          src={project.image} 
          alt={project.title} 
          class="h-full w-full scale-100 object-cover transition-transform duration-1000 ease-out group-hover:scale-105"
          loading="lazy"
        />
      ) : (
        <div class="paper-grid flex h-full w-full flex-col items-center justify-center p-8 text-center">
          <span class="mb-5 text-6xl transition-transform duration-500 group-hover:rotate-12 group-hover:scale-110">✦</span>
          <span class="font-display max-w-md text-3xl leading-tight text-[#161616]">{project.title}</span>
        </div>
      )}
    </div>
    
    <div class="absolute inset-2 flex items-center justify-center rounded-[1.25rem] bg-[#2457ff]/80 opacity-0 backdrop-blur-[2px] transition-opacity duration-300 group-hover:opacity-100">
      <div class="flex h-24 w-24 scale-0 rotate-12 items-center justify-center rounded-full border-2 border-[#161616] bg-[#ffd426] text-[#161616] shadow-[4px_4px_0_#161616] transition-transform duration-500 group-hover:scale-100">
        <span class="text-xs font-extrabold uppercase tracking-widest">Open ↗</span>
      </div>
    </div>
  </div>

  <div class="flex items-start justify-between gap-6 px-1">
    <div>
      <h3 class="font-display mb-2 text-2xl leading-tight md:text-3xl">{project.title}</h3>
      <p class="inline-flex rounded-full bg-[#161616] px-3 py-1 text-xs font-bold text-white">{project.category}</p>
    </div>
    
    <div class="text-right">
      <span class="text-sm font-extrabold">{project.year}</span>
      
      <div class="overflow-hidden h-5 mt-1">
        <p class="translate-y-full text-xs font-medium text-[#666] transition-transform duration-500 group-hover:translate-y-0">
          {project.tech}
        </p>
      </div>
    </div>
  </div>
</a>
