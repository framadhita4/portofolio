---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  index: number;
  class?: string;
}

const { project, index, class: className = "" } = Astro.props;
---

<div
  data-filter-group={project.filterGroup}
  data-index={index}
  class={`project-slide swipe-card relative shrink-0 min-w-0 select-none flex items-center justify-center h-[420px] sm:h-[500px] md:h-[620px] lg:h-[720px] xl:h-[800px] ${className}`}
>
  <!-- 1. BORDERLESS VERTICAL GRADIENT CARD (Tracking anchor for Three.js GLSL from swipeeeeee) -->
  <div
    class="card-gradient-slot relative w-[210px] sm:w-[270px] md:w-[350px] lg:w-[430px] xl:w-[490px] h-[301px] sm:h-[387px] md:h-[502px] lg:h-[616px] xl:h-[702px] pointer-events-none select-none transition-all duration-300"
    data-index={index}
    data-slug={project.slug}
  ></div>

  <!-- 2. FOREGROUND HORIZONTAL PROJECT BANNER (Overlapping across vertical gradient like user's drawing) -->
  <div
    class="project-banner absolute z-20 w-[280px] sm:w-[360px] md:w-[460px] lg:w-[550px] xl:w-[630px] max-w-[92vw] h-[175px] sm:h-[225px] md:h-[285px] lg:h-[340px] xl:h-[380px] rounded-2xl sm:rounded-3xl overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.85)] sm:shadow-[0_30px_70px_rgba(0,0,0,0.85)] border border-white/20 bg-zinc-950 transition-all duration-300 hover:scale-[1.02] hover:border-white/50 group"
  >
    <a
      href={`/project/${project.slug}`}
      draggable="false"
      class="block w-full h-full relative cursor-pointer select-none"
    >
      <!-- Thumbnail Project Image -->
      {project.image ? (
        <img
          src={project.image}
          alt={`${project.title} Thumbnail`}
          class="w-full h-full object-cover object-top filter brightness-[0.9] contrast-[1.05] transition-transform duration-500 group-hover:scale-105 pointer-events-none select-none"
          loading="lazy"
          draggable="false"
        />
      ) : (
        <div class="w-full h-full flex flex-col justify-between p-4 sm:p-6 md:p-8 bg-gradient-to-br from-zinc-900 via-neutral-900 to-black relative select-none">
          <div class="absolute inset-0 bg-[radial-gradient(#ffffff0a_1px,transparent_1px)] [background-size:20px_20px] pointer-events-none"></div>
          <div class="my-auto text-center opacity-30 select-none">
            <span class="text-4xl sm:text-5xl md:text-6xl font-black font-mono tracking-widest text-white/40 block">0{index + 1}</span>
            <span class="text-[11px] sm:text-xs md:text-sm uppercase font-mono tracking-widest text-white/30 block mt-1 sm:mt-2">{project.filterGroup}</span>
          </div>
        </div>
      )}

      <!-- Vignette and Dark Gradient Overlay for Contrast -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/25 to-black/0 pointer-events-none"></div>

      <!-- Top Badges Overlay -->
      <div class="absolute top-3 sm:top-5 left-4 sm:left-6 right-4 sm:right-6 flex items-center justify-between pointer-events-none z-10">
        <span class="px-2.5 sm:px-3.5 py-1 sm:py-1.5 rounded-full bg-black/60 backdrop-blur-md border border-white/20 text-white text-[10px] sm:text-xs font-bold uppercase tracking-wider">
          {project.category}
        </span>
        <span class="px-2.5 sm:px-3.5 py-1 sm:py-1.5 rounded-full bg-black/60 backdrop-blur-md border border-white/20 text-white text-[10px] sm:text-xs font-mono font-bold">
          {project.year}
        </span>
      </div>

      <!-- Bottom: Project Name (Teks Nama Project) on Left, Open Arrow on Right -->
      <div class="absolute bottom-3.5 sm:bottom-6 left-4 sm:left-6 right-4 sm:right-6 flex items-end justify-between pointer-events-none z-10">
        <div class="max-w-[78%] sm:max-w-[80%] pr-2 sm:pr-3">
          <h3 class="text-lg sm:text-2xl md:text-3xl lg:text-4xl font-black tracking-tight text-white leading-tight drop-shadow-md group-hover:underline decoration-white/70 underline-offset-4 line-clamp-1 transition-transform duration-500">
            {project.title}
          </h3>
          <div class="project-desc-wrapper">
            <div class="project-desc-content">
              <p class="project-desc-text text-[11px] sm:text-xs md:text-sm lg:text-base text-white/80 line-clamp-1 sm:line-clamp-2 pt-1 sm:pt-1.5 font-medium">
                {project.desc}
              </p>
            </div>
          </div>
        </div>

        <div class="w-8 h-8 sm:w-10 sm:h-10 md:w-12 md:h-12 rounded-full bg-white text-ink flex items-center justify-center font-bold text-xs sm:text-sm md:text-base shadow-lg transition-transform duration-300 group-hover:translate-x-0.5 group-hover:bg-accent group-hover:text-white shrink-0">
          ↗
        </div>
      </div>
    </a>
  </div>
</div>

<style>
  .project-desc-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: grid-template-rows;
  }

  .group:hover .project-desc-wrapper,
  .project-banner:hover .project-desc-wrapper {
    grid-template-rows: 1fr;
  }

  .project-desc-content {
    min-height: 0;
    overflow: hidden;
  }

  .project-desc-text {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  .group:hover .project-desc-text,
  .project-banner:hover .project-desc-text {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.05s;
  }

  .project-banner,
  .project-banner a,
  .project-banner img {
    -webkit-user-drag: none;
    user-select: none;
  }
</style>
