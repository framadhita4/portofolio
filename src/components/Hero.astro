---
import RollLink from "./RollLink.astro";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<section
  class={`relative min-h-screen flex flex-col justify-between pt-32 pb-12 px-5 md:px-12 border-b border-line ${className}`}
>
  <div class="max-w-[1440px] mx-auto w-full my-auto py-12">
    <!-- Meta details bar -->
    <div class="flex flex-wrap items-center justify-between gap-4 mb-8 text-xs font-medium text-muted">
      <div class="flex items-center gap-2">
        <span>Bandung, ID — Full-Stack &amp; AI Systems Engineer</span>
      </div>
    </div>

    <!-- Monumental Headline -->
    <h1 id="hero-headline" class="text-hero tracking-tight text-ink mb-12 py-2">
      <span class="block">I build software for</span>
      <span class="block">people who care</span>
      <span class="block">
        as much as <span class="text-accent italic font-light">I do.</span>
      </span>
    </h1>
  </div>

  <!-- Bottom Hero Summary Bar -->
  <div class="max-w-[1440px] mx-auto w-full pt-8 border-t border-line flex flex-col md:flex-row items-start md:items-end justify-between gap-6">
    <p class="hero-subtext text-sm md:text-base text-muted max-w-xl font-normal leading-relaxed">
      Turning ambitious operational ideas into fast, thoughtful digital products—from low-latency Rust AI engines to multi-tenant enterprise platforms.
    </p>
    <div class="flex items-center gap-6 text-xs font-semibold">
      <RollLink href="#works">
        [ Explore 18 projects ↓ ]
      </RollLink>
      <RollLink href="https://github.com/framadhita4" target="_blank" rel="noopener noreferrer">
        [ GitHub ↗ ]
      </RollLink>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";

  function splitTextIntoWords(element: HTMLElement, customClass = "word-inner") {
    if (element.dataset.splitDone) return;
    element.dataset.splitDone = "true";

    const walk = (node: Node) => {
      if (node.nodeType === 3) {
        const text = node.nodeValue || "";
        const words = text.split(/(\s+)/);
        const frag = document.createDocumentFragment();
        words.forEach((w) => {
          if (/^\s+$/.test(w) || w === "") {
            frag.appendChild(document.createTextNode(w));
          } else {
            const mask = document.createElement("span");
            mask.className = "word-mask";
            const inner = document.createElement("span");
            inner.className = customClass;
            inner.textContent = w;
            mask.appendChild(inner);
            frag.appendChild(mask);
          }
        });
        node.parentNode?.replaceChild(frag, node);
      } else if (node.nodeType === 1) {
        Array.from(node.childNodes).forEach(walk);
      }
    };
    walk(element);
  }

  function initHeroAnimations() {
    const heroHeadline = document.getElementById("hero-headline");
    if (!heroHeadline) return;

    splitTextIntoWords(heroHeadline, "hero-word word-inner");

    const heroTl = gsap.timeline({ defaults: { ease: "power4.out" } });
    heroTl
      .from(".hero-word", {
        yPercent: 115,
        rotateZ: 2,
        duration: 1.1,
        stagger: 0.04,
        delay: 0.1,
      })
      .from(
        ".hero-equation > *",
        {
          y: 24,
          opacity: 0,
          duration: 0.8,
          stagger: 0.05,
        },
        "-=0.6"
      )
      .from(
        ".hero-subtext",
        {
          y: 20,
          opacity: 0,
          duration: 0.9,
        },
        "-=0.5"
      );
  }

  document.addEventListener("astro:page-load", initHeroAnimations);
</script>
