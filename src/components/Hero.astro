---
import DoodleLottie from './DoodleLottie.astro';
---

<section class="relative min-h-screen overflow-hidden px-5 pb-12 pt-28 md:px-10 md:pb-16 md:pt-36 lg:px-12">
  <div class="absolute inset-x-0 top-20 h-[56%] pointer-events-none opacity-75 md:left-auto md:right-[-8%] md:top-8 md:h-[78%] md:w-[62%]">
    <img src="/images/doodles/hero-doodles.webp" alt="" class="h-full w-full object-contain" fetchpriority="high" />
  </div>

  <div class="relative z-10 flex min-h-[calc(100vh-10rem)] flex-col justify-between">
    <div class="mt-auto max-w-[92rem] md:mt-auto md:mb-24">
      <h1 class="font-display text-[clamp(3rem,13vw,11rem)] leading-[0.78] text-[#161616]">
        <span class="block overflow-hidden pb-[0.08em]"><span class="hero-reveal-title block translate-y-full opacity-0">I build</span></span>
        <span class="block overflow-hidden pb-[0.1em]">
          <span class="hero-reveal-title block translate-y-full opacity-0">
            <span class="scribble-underline">useful</span> things.
          </span>
        </span>
      </h1>
    </div>

    <div class="hero-reveal-bottom mt-12 flex flex-col gap-8 border-t-2 border-[#161616] pt-6 opacity-0 md:flex-row md:items-end md:justify-between">
      <p class="max-w-2xl text-base font-medium leading-relaxed text-[#454545] md:text-lg">
        Full-stack developer turning ambitious ideas into fast, thoughtful digital products—from AI platforms to everyday business tools.
      </p>
      <a href="#project-filter" class="group inline-flex w-fit items-center gap-3 rounded-full border-2 border-[#161616] bg-[#ff78b7] px-5 py-3 text-xs font-bold uppercase tracking-[0.12em] transition-transform hover:-rotate-2 hover:scale-105">
        Explore the work
        <span class="text-lg leading-none transition-transform group-hover:translate-y-1">↓</span>
      </a>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';

  document.addEventListener('astro:page-load', () => {
    const tl = gsap.timeline();

    tl.to('.hero-reveal', {
      y: 0,
      opacity: 1,
      duration: 1,
      ease: 'power3.out',
      delay: 0.2
    })
    .to('.hero-reveal-title', {
      y: 0,
      opacity: 1,
      duration: 1.2,
      stagger: 0.2,
      ease: 'power4.out'
    }, "-=0.6")
    .to('.hero-reveal-bottom', {
      opacity: 1,
      duration: 1,
      ease: 'power2.out'
    }, "-=0.4");
  });
</script>
