---
import { filterGroups } from "../data/projects";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div id="category-filters" class={`flex flex-wrap gap-2 ${className}`}>
  {filterGroups.map((group, idx) => (
    <button
      data-filter={group.id}
      class={`filter-btn px-4 py-1.5 rounded-full text-xs font-semibold transition-all duration-200 cursor-pointer ${
        idx === 0
          ? "active bg-ink text-paper"
          : "border border-line hover:border-ink bg-transparent text-ink"
      }`}
    >
      {group.label}
    </button>
  ))}
</div>
