---
interface Props {
  step: string;
  stepLabel: string;
  title: string;
  description: string;
  footer: string;
}

const { step, stepLabel, title, description, footer } = Astro.props;
---

<div class="process-card p-8 rounded-2xl border border-line bg-paper hover:border-ink transition-all duration-300 flex flex-col justify-between min-h-[320px] group">
  <div class="mb-8">
    <h3 class="text-2xl font-bold tracking-tight mb-3 text-ink">
      {title}
    </h3>
    <p class="text-sm text-muted leading-relaxed">
      {description}
    </p>
  </div>
  <div class="text-[11px] font-semibold text-accent border-t border-line pt-4 tracking-wider uppercase">
    {footer}
  </div>
</div>
