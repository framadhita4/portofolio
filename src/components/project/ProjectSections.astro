---
import type { ProjectDetails } from "../../data/projects";

interface Props {
  details?: ProjectDetails;
}

const { details } = Astro.props;
---

{details && (
  <div class="project-content mx-auto max-w-3xl translate-y-8 opacity-0 space-y-12 mb-20 text-ink">
    {details.about && (
      <section class="border-b border-line pb-10">
        <h3 class="text-2xl md:text-3xl font-bold tracking-tight mb-4 flex items-center gap-3">
          <span class="text-accent text-lg font-mono">01.</span> About the project
        </h3>
        <p class="text-base md:text-lg text-muted font-normal leading-relaxed">
          {details.about}
        </p>
      </section>
    )}

    {details.whatIDid && (
      <section class="border-b border-line pb-10">
        <h3 class="text-2xl md:text-3xl font-bold tracking-tight mb-4 flex items-center gap-3">
          <span class="text-accent text-lg font-mono">02.</span> Engineering & Architecture
        </h3>
        <p class="text-base md:text-lg text-muted font-normal leading-relaxed">
          {details.whatIDid}
        </p>
      </section>
    )}

    {details.output && (
      <section class="pb-4">
        <h3 class="text-2xl md:text-3xl font-bold tracking-tight mb-4 flex items-center gap-3">
          <span class="text-accent text-lg font-mono">03.</span> Impact & Outcomes
        </h3>
        <p class="text-base md:text-lg text-muted font-normal leading-relaxed">
          {details.output}
        </p>
      </section>
    )}
  </div>
)}
