---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<section
  class={`py-28 md:py-40 px-5 md:px-12 border-b border-line bg-ink text-paper ${className}`}
>
  <div class="max-w-[1440px] mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <div class="lg:col-span-9 space-y-12">
        <p id="scrub-statement-1" class="text-statement">
          Your software isn't an expensive decoration. It's the sharpest
          engine of your operational presence.
        </p>

        <p
          id="scrub-statement-2"
          class="text-2xl md:text-4xl font-medium tracking-tight leading-snug text-paper/90 max-w-4xl"
        >
          First, I map where your bottlenecks live → then I engineer the
          cleanest architecture to take you where you're going. High
          concurrency, zero template bloat, built to scale.
        </p>

        <div class="pt-4 flex flex-wrap items-center gap-8 text-xs font-mono text-muted border-t border-paper/10">
          <span>A <span class="text-accent mx-2">━━━▶</span> B</span>
          <span>LATENCY: &lt;15MS</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initScrubStatements() {
    ["scrub-statement-1", "scrub-statement-2"].forEach((id) => {
      const el = document.getElementById(id);
      if (!el || el.dataset.scrubDone) return;
      el.dataset.scrubDone = "true";

      const rawWords = el.innerText.trim().split(/\s+/);
      el.innerHTML = rawWords
        .map((w) => {
          const isHighlight =
            w.includes("sharpest") ||
            w.includes("engine") ||
            w.includes("→") ||
            w.includes("cleanest");
          return `<span class="scrub-word ${isHighlight ? "text-accent" : ""}">${w}</span>`;
        })
        .join(" ");

      gsap.to(el.querySelectorAll(".scrub-word"), {
        scrollTrigger: {
          trigger: el,
          start: "top 82%",
          end: "bottom 45%",
          scrub: 0.5,
        },
        opacity: 1,
        stagger: 0.08,
        ease: "none",
      });
    });
  }

  document.addEventListener("astro:page-load", initScrubStatements);
</script>
