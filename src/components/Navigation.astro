---
import RollLink from "./RollLink.astro";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<header
  id="main-header"
  class={`fixed top-0 left-0 w-full z-50 px-5 md:px-12 py-5 bg-paper/85 backdrop-blur-md border-b border-line flex items-center justify-between text-xs transition-transform duration-300 ${className}`}
>
  <div class="flex items-center gap-6">
    <a
      href="/"
      class="font-extrabold text-base tracking-[-0.05em] flex items-center gap-1 text-ink"
    >
      FRAMADHIT4°<span class="inline-block w-2 h-2 rounded-full bg-accent"></span>
    </a>
  </div>

  <!-- Navigation Links -->
  <nav class="flex items-center gap-5 md:gap-7 text-xs font-semibold">
    <RollLink href="/#works">
      Portfolio
    </RollLink>
    <RollLink href="/#process">
      Process
    </RollLink>
    <RollLink href="/#faq" class="hidden sm:inline-flex">
      Stack.md
    </RollLink>
    <a
      href="mailto:me@framadhita.com"
      class="px-3.5 py-1.5 rounded-full bg-ink text-paper hover:bg-accent transition-colors duration-300 text-[11px] tracking-tight font-bold"
    >
      [ Let's talk ]
    </a>
  </nav>
</header>
