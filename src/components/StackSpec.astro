---
import CapabilitiesSpec from "./CapabilitiesSpec.astro";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<section
  id="faq"
  class={`py-28 md:py-36 px-5 md:px-12 border-b border-line bg-carbon text-paper ${className}`}
>
  <div class="max-w-[1440px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
    <div class="lg:col-span-5">
      <h2 class="text-4xl md:text-6xl font-bold tracking-[-0.04em] leading-none mb-6 split-heading text-paper">
        Quality is non-negotiable.
      </h2>
      <p class="text-muted text-base leading-relaxed mb-8 font-normal">
        Every system I deliver is responsive, performance-optimized, strictly
        typed, and built with clean modular architecture.
      </p>

      <!-- Quick Specs Matrix -->
      <div class="p-6 rounded-2xl border border-paper/10 bg-paper/[0.03] space-y-3 text-xs">
        <div class="flex justify-between">
          <span class="text-muted">PRIMARY LANGUAGES</span>
          <span class="font-semibold">Rust, TypeScript, PHP, Python</span>
        </div>
        <div class="flex justify-between border-t border-paper/10 pt-3">
          <span class="text-muted">FRONTEND &amp; MOTION</span>
          <span class="font-semibold">React, Next.js, Vue/Nuxt, GSAP</span>
        </div>
        <div class="flex justify-between border-t border-paper/10 pt-3">
          <span class="text-muted">BACKEND &amp; AI</span>
          <span class="font-semibold">Axum, Laravel, MCP, RAG, Vector DBs</span>
        </div>
      </div>
    </div>

    <!-- Right Side: Interactive Markdown Spec Editor -->
    <div class="lg:col-span-7">
      <CapabilitiesSpec />
    </div>
  </div>
</section>
